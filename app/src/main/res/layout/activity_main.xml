<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <com.prolificinteractive.materialcalendarview.MaterialCalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            style="@style/CustomCalendar"/>

        <!-- Горизонтальный блок с текстом и полем ввода даты -->
        <LinearLayout
            android:id="@+id/date_input_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/calendarView"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textView_selected_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выбранная дата:"
                android:textSize="18sp"
                android:layout_marginEnd="8dp" />

            <com.vicmikhailau.maskededittext.MaskedEditText
                android:id="@+id/editText_date_input"
                android:layout_width="106dp"
                android:layout_height="wrap_content"
                android:hint="дд/мм/гггг"
                android:inputType="number"
                android:backgroundTint="#888888"
                android:textSize="18sp"
                android:padding="6dp"
                app:mask="##/##/####" />

        </LinearLayout>

        <TextView
            android:id="@+id/resultShow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result"
            android:layout_below="@id/date_input_block"
            android:layout_marginTop="50dp"
            android:textSize="50sp"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
